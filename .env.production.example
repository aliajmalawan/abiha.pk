# ABIHA.PK: PRODUCTION environment template.
#
#   cp .env.production.example .env        (in the PRIVATE application folder, never inside public_html)
#   php artisan key:generate --force       (fills APP_KEY)
#
# Rules:
#   * This file is a template and contains NO secrets. The real .env must never be uploaded to the public folder,
#     committed to version control, emailed or pasted into chat. Permissions: 600 (or 640).
#   * After editing .env always run `php artisan optimize` (config is cached; edits are not seen until you do).
#   * Values containing spaces or # must be wrapped in double quotes.

APP_NAME="ABIHA.PK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The exact public address, https, no trailing slash. Used for links in emails, the sitemap, canonical URLs and trusted hosts.
APP_URL=https://YOUR-DOMAIN.example
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Development placeholders ("SAMPLE" flags) must never show on the live site.
ABIHA_SAMPLE_LABELS=false

# --- Where the PUBLIC files live (the web root). Required for the cPanel layout where the app is in /home/CPANELUSER/abiha and the
# public files are in /home/CPANELUSER/public_html. Leave it out only if the domain's document root is <app folder>/public. ---
PUBLIC_PATH=/home/CPANELUSER/public_html

# --- Logging: one file per day under storage/logs, kept 30 days, errors and worse only ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# --- Database: create it in cPanel → MySQL Databases (the cPanel user prefix is part of every name) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions: encrypted, https-only cookies, staff signed out after 30 idle minutes ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
ADMIN_IDLE_MINUTES=30

# --- Cache / queue: nothing in the application is queued, so no worker or scheduler is needed ---
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Uploads (product photos etc.) ---
FILESYSTEM_DISK=local
# Only if your host forbids symlinks (`php artisan abiha:prepare-storage` tells you): write uploads straight into the web root.
# PUBLIC_DISK_ROOT=/home/CPANELUSER/public_html/storage

# --- Mail: needed for password-reset emails. Use the mailbox you created in cPanel → Email Accounts ---
MAIL_MAILER=smtp
# Port 465 → MAIL_SCHEME=smtps (implicit TLS).  Port 587 → MAIL_SCHEME=smtp (STARTTLS).
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Online payments: none are registered yet. When a provider is added, its API keys and webhook secret go HERE (never in
# the admin dashboard, never in code). Cash on delivery and bank transfer need no keys. ---

BROADCAST_CONNECTION=log
