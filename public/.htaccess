# ---- Performance: compression + long-lived caching for files whose names change when their content does ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/javascript text/javascript application/json application/ld+json image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_headers.c>
    # Vite output is content-hashed (app-AbC123.js): safe to cache for a year
    <FilesMatch "^.+\.(js|css|woff2)$">
        <If "%{REQUEST_URI} =~ m#/build/assets/#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>
    # Uploaded images get a random name and are never edited in place (a replacement is a new file)
    <If "%{REQUEST_URI} =~ m#/storage/.+\.(jpe?g|png|webp|gif|ico)$#i">
        Header set Cache-Control "public, max-age=2592000"
    </If>
    # Brand artwork: a month, then revalidate
    <If "%{REQUEST_URI} =~ m#/assets/brand/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
</IfModule>
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Never serve dotfiles (.env, .git, .htpasswd …) or backup/dump/log files, even if one is dropped into public/
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(env|log|sql|sqlite|bak|old|orig|swp|ini|inc|sh|yml|yaml|lock)$ - [F,L,NC]

    # Send every real domain to HTTPS (301). Skipped for localhost so local development keeps working over http, for the
    # /.well-known/ folder (AutoSSL / Let's Encrypt validate the domain over plain http), and behind a proxy that already
    # terminated TLS (X-Forwarded-Proto).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_URI} !(^|/)\.well-known/
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
