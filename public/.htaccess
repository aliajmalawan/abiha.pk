# ---- Performance: compression + caching ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/javascript text/javascript application/json application/ld+json image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_headers.c>
    # CSS/JS/fonts carry ?v=<mtime> (asset() helper), fonts have hashed names: a month is safe
    <FilesMatch "\.(js|css|woff2|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Uploaded images get a random name and are never edited in place (a replacement is a new file)
    <If "%{REQUEST_URI} =~ m#/storage/.+\.(jpe?g|png|webp|gif|ico)$#i">
        Header set Cache-Control "public, max-age=2592000"
    </If>
    # Brand artwork: a month, then revalidate
    <If "%{REQUEST_URI} =~ m#/assets/brand/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Never serve dotfiles (.env, .git, .htpasswd ...) or backup/dump/log files, even if one is dropped into public/
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(env|log|sql|sqlite|bak|old|orig|swp|ini|inc|sh|yml|yaml|lock)$ - [F,L,NC]

    # Send every real domain to HTTPS (301). Skipped for localhost so local development keeps working over http, for the
    # /.well-known/ folder (AutoSSL / Let's Encrypt validate the domain over plain http), and behind a proxy that already
    # terminated TLS (X-Forwarded-Proto).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_URI} !(^|/)\.well-known/
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send requests to the front controller (existing files are served directly)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
