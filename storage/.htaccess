# storage/ is private (logs, sessions, cache, backups, payment proofs). Nothing here is served...
# ...except uploaded images when the domain's document root is the PROJECT folder (not public/): then the URL
# /storage/<path> arrives here and is served from storage/app/public/<path> (the "public" disk). Images and product videos only.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 1) Photos and videos in public/storage (the normal home of uploads: the same folder every web-root layout serves)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^(.*)/storage/(.+\.(?:jpe?g|png|webp|gif|ico|mp4|webm))$ [NC]
    RewriteCond %{DOCUMENT_ROOT}%1/public/storage/%2 -f
    RewriteRule ^(?!app/public/)(.+)$ ../public/storage/$1 [L]
    # 2) Older installs that keep uploads in storage/app/public
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(?!app/public/)(.+\.(?:jpe?g|png|webp|gif|ico|mp4|webm))$ app/public/$1 [L,NC]
    RewriteCond %{ENV:REDIRECT_STATUS} !^$
    RewriteRule ^app/public/.+\.(?:jpe?g|png|webp|gif|ico|mp4|webm)$ - [L,NC]
    RewriteRule ^ - [F]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
