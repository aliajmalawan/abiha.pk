APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=abiha_pk
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=Asia/Karachi

# --- Security (see docs/ARCHITECTURE.md → Phase 7) ---
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
ADMIN_IDLE_MINUTES=30
# Secrets (database password, mail password, payment provider keys/webhook secrets) belong ONLY in the server's .env.
# Never commit .env, never put a secret in config files or the admin settings. Production must have APP_DEBUG=false.
# Run `php artisan abiha:security-check --probe` after every deploy.

# --- Deployment (see docs/DEPLOYMENT.md; use .env.production.example as the starting point for the live site) ---
# Development placeholders ("SAMPLE" flags). Defaults to ON locally and OFF in production; set explicitly only if you need to.
# ABIHA_SAMPLE_LABELS=true
# cPanel "split" layout only: the folder that is the web root (e.g. /home/USER/public_html). Leave unset for a normal checkout.
# PUBLIC_PATH=
# Hosts that forbid symlinks: write uploads straight into the web root instead of using public/storage.
# PUBLIC_DISK_ROOT=

# Card payments stay DISABLED until all four are filled in (see docs/PAYMENTS.md). Never commit real values.
CARD_PAYMENT_DRIVER=
CARD_API_KEY=
CARD_API_SECRET=
CARD_WEBHOOK_SECRET=
