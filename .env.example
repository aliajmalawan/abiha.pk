# ---------------------------------------------------------------------------
# ABIHA - environment template. PLACEHOLDERS ONLY, no secrets.
# `php bin/console.php setup` copies it to .env with a random APP_KEY (local XAMPP defaults).
# Never commit, email or paste the real .env. Values with spaces or # go in double quotes.
# ---------------------------------------------------------------------------

# development | production   (production refuses to start with weak or missing secrets)
APP_ENV=production
APP_DEBUG=false
# Public base URL, no trailing slash. XAMPP: http://localhost/abiha.pk   Live: https://YOUR-DOMAIN.example
APP_URL=https://YOUR-DOMAIN.example
# 64 random hex characters (php -r "echo bin2hex(random_bytes(32));")
APP_KEY=CHANGE_ME

# Times are stored and shown in this zone, exactly like the old site.
BUSINESS_TIMEZONE=Asia/Karachi
# Number of trusted reverse proxies in front of the app (0 = none).
TRUSTED_PROXY_HOPS=0

# Sessions: minutes without a request before a visitor is signed out. Staff: ADMIN_IDLE_MINUTES.
SESSION_LIFETIME=120
ADMIN_IDLE_MINUTES=30

# Development placeholders ("SAMPLE" flags). Leave false on the live site.
ABIHA_SAMPLE_LABELS=false

# MySQL / MariaDB (MySQLi). Production: a least-privilege user, never root.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Separate database used by the automated tests (WIPED on every run; its name must contain "test").
DB_TEST_DATABASE=abiha_pk_test

# Uploads (the "public" disk). Default storage/app/public, served at APP_URL/storage through public/storage
# (`php bin/console.php storage:link`). Hosts that forbid symlinks: a folder INSIDE the web root, e.g.
# /home/CPANELUSER/public_html/storage (then no link is needed).
PUBLIC_DISK_ROOT=
PUBLIC_DISK_URL=
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_PROOF_BYTES=5242880

# Email. MAIL_DRIVER: smtp (production) | outbox (development: writes files to storage/mail)
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="ABIHA"
# Staff inbox for new-order alerts (optional)
MAIL_ADMIN_NOTIFY=
SMTP_HOST=CHANGE_ME
# 465 + ssl (implicit TLS) or 587 + tls (STARTTLS)
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# Payment methods customers may choose (comma-separated): cod, bank_transfer, card
PAYMENTS_ENABLED=cod,bank_transfer
# Card payments (Safepay) stay OFF until the three keys below are filled. CARD_ENVIRONMENT: sandbox while testing, production when live.
CARD_PAYMENT_DRIVER=App\Services\Payments\Drivers\SafepayDriver
CARD_ENVIRONMENT=sandbox
CARD_API_KEY=
CARD_API_SECRET=
CARD_WEBHOOK_SECRET=
