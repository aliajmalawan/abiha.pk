# ABIHA - project root.
# Used when the domain's document root is this folder instead of public/: every request is routed into public/.
# Source code, storage, database files, tests, docs and .env are never served.
Options -Indexes -MultiViews
DirectoryIndex index.php

<FilesMatch "^\.|\.(env|sql|md|log|lock|ini|sh|bak|json|zip)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # (Uploaded images under /storage/... are handled by storage/.htaccess.)
    # Block direct access to private directories.
    RewriteRule ^(app|bin|database|storage|tests|docs|resources|backups|live-import)(/|$) - [F,L]
    # Route everything else into public/.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
